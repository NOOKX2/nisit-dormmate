DATABASE_URL=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

JWT_SECRET=

# Google OAuth (Sign in with Google — ไม่ใช้ NextAuth)
# ทั้งสองค่าจำเป็น: Client ID (หน้าเว็บ) + Client secret (ฝั่งเซิร์ฟเวอร์เท่านั้น ห้าม NEXT_PUBLIC_)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ต้องตรงกับ Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000
# ลงนาม session_token; ถ้าไม่ตั้งจะ fallback ใช้ JWT_SECRET
SESSION_SECRET=

CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Cloudflare R2 Configuration for File Upload
CLOUDFLARE_R2_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID="your-access-key-id"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your-secret-access-key"
CLOUDFLARE_R2_BUCKET_NAME="your-bucket-name"
CLOUDFLARE_R2_PUBLIC_URL="https://your-public-domain.com"

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=