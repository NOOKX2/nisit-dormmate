generator client {
   provider = "prisma-client-js" 
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  OWNER
}

// 🌟 ข้อมูลผู้ใช้งาน (นิสิต)
model User {
  id               String    @id @default(cuid())

  firstName        String
  lastName         String
  nickName         String

  email            String    @unique
  password         String?
  image            String?
  faculty          String?   // คณะ (เช่น วิศวะ, เกษตร)
  year             Int?      // ชั้นปี
  role             Role      @default(USER)

  imageUrl         String?

  // --- Lifestyle Quiz Data (สำหรับหารูมเมท) ---
  // ทุกฟิลด์เป็น Optional (?) เพราะ user จะมีค่าเหล่านี้หลังทำ Quiz เสร็จเท่านั้น
  
  study_time       String?   // morning, afternoon, flexible
  location         String?   // room, outside
  guest_policy     String?   // open, limit, private
  cleanliness      String?   // neat, messy
  air_con          String?   // save, cool
  smoking          Boolean?   // yes, no
  sleepHabit       String?
  
  // เก็บสถานะว่าทำ Quiz จบหรือยัง
  hasCompletedQuiz Boolean   @default(false)

  // --- Relationships ---
  bookings         Booking[]
  reviews          Review[]

  // 🤝 เพิ่มความสัมพันธ์สำหรับ "รีวิวรูมเมท" (Mate Karma)
  roommateReviewsGiven    RoommateReview[] @relation("Reviewer")
  roommateReviewsReceived RoommateReview[] @relation("TargetUser")

  // --- Metadata ---
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sentMatches     MatchRequest[] @relation("SentMatches")
  receivedMatches MatchRequest[] @relation("ReceivedMatches")
}

// 🏢 ข้อมูลหอพัก
model Dorm {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  description   String?
  locationShort String // เช่น "ซอยพหลโยธิน 45"

  // 📍 --- ส่วนที่เพิ่มใหม่สำหรับ Google Maps ---
  address       String?         // ที่อยู่แบบเต็ม (เช่น บ้านเลขที่ ถนน ตำบล) เพื่อให้ iframe ค้นหาแม่นยำขึ้น
  lat           Float?          // ละติจูด (Latitude) เผื่ออนาคตทำระบบ "ค้นหาหอพักใกล้ฉัน"
  lng           Float?          // ลองจิจูด (Longitude)
  googleMapUrl  String?         // ลิงก์ Google Maps ตรงๆ (เผื่อเจ้าของหอก๊อปปี้ลิงก์มาวาง)
  // ------------------------------------------

  priceRange    DormPriceRange?
  imageUrl      String?
  rating        Float           @default(0)
  reviewCount   Int             @default(0)

  // ค่าใช้จ่ายเพิ่มเติม (Utility & Common fee)
  electricRate  Int     @default(0)         // ค่าไฟ บาท/หน่วย
  waterRate     Int     @default(0)        // ค่าน้ำ บาท/หน่วย
  commonFee     Int     @default(0)       // ค่าส่วนกลาง บาท/เดือน

  // สิ่งอำนวยความสะดวก (เก็บเป็น Array ของ key)
  indoorAmenities String[]      @default([]) // ภายในห้อง
  commonAmenities String[]      @default([]) // ส่วนกลาง

  // คะแนนย่อย (Scores)
  wifiScore     Float?
  securityScore Float?
  ownerScore    Float?

  // Relationships
  rooms     Room[]
  reviews   Review[]
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 🛏️ ข้อมูลห้องพัก
model Room {
  id          String  @id @default(cuid())
  name        String // เช่น "ห้องแอร์ เตียงคู่"
  description String?
  price       Int
  capacity    Int     @default(2)
  isAvailable Boolean @default(true)
  floor       Int     @default(1)

  dormId    String
  dorm      Dorm      @relation(fields: [dormId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 💬 ข้อมูลรีวิว
model Review {
  id           String @id @default(cuid())
  rating       Int
  comment      String
  helpfulCount Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id])
  dormId String
  dorm   Dorm   @relation(fields: [dormId], references: [id])

  createdAt DateTime @default(now())
}

// 📅 ข้อมูลการจอง
model Booking {
  id     String @id @default(cuid())
  dormId String
  dorm   Dorm   @relation(fields: [dormId], references: [id])

  // ข้อมูลผู้จอง (แบบง่ายสำหรับ Demo)
  customerName  String
  customerPhone String

  // รายละเอียดการจอง
  roomType    String @default("ห้องมาตรฐาน")
  price       Int
  deposit     Int
  serviceFee  Int
  totalAmount Int
  status      String @default("PENDING") // PENDING, SUCCESS, CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  room      Room?    @relation(fields: [roomId], references: [id])
  roomId    String?
}

model DormPriceRange {
  id       String @id @default(cuid())
  minPrice Int // เก็บเป็น Int เพื่อให้คำนวณหรือ Filter ง่าย
  maxPrice Int

  // 🔑 Foreign Key เชื่อมไปยัง Dorm
  dormId String @unique // @unique สำหรับ One-to-One
  dorm   Dorm   @relation(fields: [dormId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}


model Post {
  id          String   @id @default(cuid())
  content     String   @db.Text
  authorId    String   // ID ของคนโพสต์
  authorName  String   // ชื่อคนโพสต์ (เก็บไว้เลยจะได้ไม่ต้อง Join ให้เหนื่อยใน Hackathon)
  tag         String?  // เช่น "หาเมท", "รีวิวหอ", "เตือนภัย"
  createdAt   DateTime @default(now())
}

model Message {
  id         String   @id @default(cuid())
  text       String   @db.Text   // ใช้ @db.Text เผื่อนิสิตพิมพ์ข้อความยาวๆ
  senderId   String   // ID ของคนส่งข้อความ
  receiverId String   // ID ของคนรับข้อความ
  createdAt  DateTime @default(now())
}


// 🤝 ข้อมูลรีวิวรูมเมท (Mate Karma)
model RoommateReview {
  id                 String   @id @default(cuid())
  
  // รหัสของนิสิตที่เข้าไปเขียนรีวิว
  reviewerId         String
  reviewer           User     @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  
  // รหัสของรูมเมทที่ "ถูกรีวิว"
  targetUserId       String
  targetUser         User     @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)

  // คะแนนย่อย 3 ด้าน (1-5)
  considerationScore Int      // ความเกรงใจ
  cleanlinessScore   Int      // ความสะอาด
  financeScore       Int      // การเงิน

  // ข้อความรีวิว
  comment            String   @db.Text
  
  // สถานะและสถิติ
  isVerified         Boolean  @default(false) // ยืนยันว่าเคยเป็นรูมเมทกันจริง
  helpfulCount       Int      @default(0)     // คนกดมีประโยชน์ (Thumbs Up)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // 🛡️ ป้องกันการปั่นรีวิว: 1 คน (Reviewer) สามารถรีวิวรูมเมท (Target) คนเดิมได้แค่ 1 ครั้ง
  @@unique([reviewerId, targetUserId])
  
  // ⚡️ เพิ่ม Index เพื่อให้ดึงคะแนนของ TargetUser มาคำนวณ Mate Karma ได้เร็วปรู๊ดปร๊าด
  @@index([targetUserId])
}

// 1. สร้าง Enum สำหรับสถานะ
enum MatchStatus {
  PENDING   // ส่งคำชวนไปแล้ว (รอเขาตอบ)
  ACCEPTED  // ตอบตกลง (เป็นเมทกันแล้ว!)
  REJECTED  // ปฏิเสธ
}

// 2. สร้างตารางเก็บคำขอ
model MatchRequest {
  id          String      @id @default(cuid())
  
  senderId    String      // คนกดชวน
  sender      User        @relation("SentMatches", fields: [senderId], references: [id])
  
  receiverId  String      // คนถูกชวน
  receiver    User        @relation("ReceivedMatches", fields: [receiverId], references: [id])
  
  status      MatchStatus @default(PENDING)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // 🛡️ ป้องกันการส่งคำขอซ้ำ! คู่เดิมจะส่งคำขอได้แค่ 1 รายการเท่านั้น
  @@unique([senderId, receiverId])
}